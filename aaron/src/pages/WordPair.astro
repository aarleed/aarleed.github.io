---
// ayo why you lookin at the code 
import "../styles/style.css";
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WordPair</title>
    <!-- <link rel="stylesheet" href="../styles/style.css"> -->

    <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"
  />
    <link rel="preconnect" href="https://fonts.cdnfonts.com" crossorigin />
    <link href="https://fonts.cdnfonts.com/css/tex-gyre-heros" rel="stylesheet" />
</head>
<body>
    <div id="start-screen">
        <button type="button" id="start-theme-btn" class="game-icon-btn theme-toggle-btn" aria-label="Toggle theme">
            <span class="theme-icon-wrap" aria-hidden="true">
                <svg class="game-icon theme-icon theme-icon--sun" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/>
                    <path d="M12 2V4M12 20V22M4 12H2M22 12H20M6.34 6.34L4.93 4.93M19.07 19.07L17.66 17.66M17.66 6.34L19.07 4.93M4.93 19.07L6.34 17.66" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                <svg class="game-icon theme-icon theme-icon--moon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </span>
            <span class="game-tooltip" aria-hidden="true">Theme</span>
        </button>
        <div id="start-screen-content">
            <div id="start-screen-heading">
                <div id="start-logo-title">
                    <img id="start-icon" src="/wordpair-logo.svg" alt="WordPair logo" />
                    <img id="start-icon-dark" src="/wordpair-logo-dark.svg" alt="WordPair logo" />
                    <div id="start-title">WordPair</div>
                </div>
                <p id="start-subtitle"></p>
            </div>
            <div id="card-flip-container">
                <div id="card-flipper">
                    <div id="card-front">
                        <img src="/mta-card.png" alt="WordPair card" />
                    </div>
                    <div id="card-back">
                        <img src="/mta-card-back.png" alt="WordPair card back" class="card-back-img" />
                        <div id="start-actions">
                            <time id="start-date"></time>
                            <div id="start-buttons">
                                <button type="button" id="start-primary-btn"></button>
                                <button type="button" id="start-secondary-btn">How to Play</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="onboarding-modal">
        <div id="onboarding-card">
            <img id="onboarding-image" src="/assets/wordpair-how-to-play.png" alt="Game preview showing word cards being flipped" />
            <div id="onboarding-content">
                <div id="onboarding-instructions">
                    <p id="onboarding-label">HOW TO PLAY</p>
                    <p id="onboarding-heading">Flip over cards and match related words into pairs.</p>
                </div>
                <p id="onboarding-rules">Tap on a card to flip it over, &amp; tap on another card to find its match. Find all 6 pairs without 6 mistakes!</p>
            </div>
            <div id="onboarding-action">
                <button type="button" id="onboarding-start-btn">Start Game</button>
            </div>
        </div>
    </div>

    <div id="instructions-modal" class="modal-class instructions-modal">
        <div id="instructions-content" role="dialog" aria-modal="true" aria-labelledby="instructions-heading">
            <button type="button" id="instructions-close" class="instructions-close-btn" aria-label="Close how to play">
                <svg class="instructions-close-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M6 6L18 18M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                <span class="game-tooltip" aria-hidden="true">Close</span>
            </button>
            <div class="sheet-fade sheet-fade--top" aria-hidden="true"></div>
            <div class="instructions-sheet-body" data-sheet-scroll>
                <header class="instructions-block instructions-heading-block">
                    <h2 id="instructions-heading" class="instructions-h2">How to Play</h2>
                    <p class="instructions-lead">Flip over cards and match related words into pairs.</p>
                </header>
                <section class="instructions-block instructions-rules" aria-labelledby="instructions-rules-heading">
                    <h3 id="instructions-rules-heading" class="instructions-h4">Rules</h3>
                    <ol class="instructions-ol">
                        <li class="instructions-li">Each word must be <strong>semantically related</strong>—they may be synonyms, antonyms, or share a common theme. Each word has <strong>exactly one</strong> pairing word.</li>
                        <li class="instructions-li">Find all 6 pairs without making 6 mistakes.</li>
                    </ol>
                </section>
                <section class="instructions-block instructions-mistake" aria-labelledby="instructions-mistake-heading">
                    <h3 id="instructions-mistake-heading" class="instructions-h4">What's a mistake?</h3>
                    <p class="instructions-body">A mistake happens when you flip over a card you've already flipped before, but don't find its match.</p>
                </section>
                <section class="instructions-block instructions-examples" aria-labelledby="instructions-examples-heading">
                    <h3 id="instructions-examples-heading" class="instructions-h4">Examples</h3>
                    <div class="instructions-example-row">
                        <div class="instructions-example-card instructions-example-card--green">dull</div>
                        <span class="instructions-example-muted">and</span>
                        <div class="instructions-example-card instructions-example-card--green">sharp</div>
                        <span class="instructions-example-muted">are a pair.</span>
                    </div>
                    <div class="instructions-example-row">
                        <div class="instructions-example-card instructions-example-card--orange">damp</div>
                        <span class="instructions-example-muted">and</span>
                        <div class="instructions-example-card instructions-example-card--orange">wet</div>
                        <span class="instructions-example-muted">are a pair.</span>
                    </div>
                    <div class="instructions-example-row">
                        <div class="instructions-example-card instructions-example-card--blue">Vegas</div>
                        <span class="instructions-example-muted">and</span>
                        <div class="instructions-example-card instructions-example-card--blue">gamble</div>
                        <span class="instructions-example-muted">are a pair.</span>
                    </div>
                </section>
            </div>
            <div class="sheet-fade sheet-fade--bottom" aria-hidden="true"></div>
        </div>
    </div>

    <div id="stats-sheet" class="stats-sheet" aria-modal="true" role="dialog" aria-label="Game statistics">
        <div id="stats-sheet-card">
            <button type="button" id="stats-close" class="stats-close-btn" aria-label="Close statistics">
                <svg class="instructions-close-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M6 6L18 18M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
                <span class="game-tooltip" aria-hidden="true">Close</span>
            </button>
            <!-- Streak animation — plays first when the sheet opens after a win.
                 "Done" reveals the stats content below. -->
            <div id="streak-main">
                <div id="streak-top">
                    <p id="streak-label">Current Streak</p>
                    <div id="streak-path">
                        <div id="streak-track">
                            <div class="streak-conn-first"></div>
                            <div class="streak-circ streak-circ-first">
                                <span class="streak-circ-num">1</span>
                            </div>
                            <div class="streak-conn-line streak-conn"></div>
                            <div class="streak-circ streak-circ-second">
                                <span class="streak-circ-num">2</span>
                            </div>
                            <div class="streak-gray-line"></div>
                            <div class="streak-bg-line"></div>
                        </div>
                    </div>
                </div>
                <div id="streak-train-container">
                    <img src="/wordpair-train.svg" alt="" />
                    <div id="streak-train-line"></div>
                </div>

            </div>
            <div class="sheet-fade sheet-fade--top" aria-hidden="true"></div>
            <div id="stats-sheet-content" data-sheet-scroll>
                <div id="stats-header"></div>
                <div id="stats-grid" class="stats-grid"></div>
                <div id="stats-distribution">
                    <p class="stats-section-title">Mistake Distribution</p>
                    <div id="stats-bars"></div>
                </div>
                <div id="stats-answers">
                    <p class="stats-section-title">Answers</p>
                    <div id="stats-pairs"></div>
                </div>
            </div>
            <div class="sheet-fade sheet-fade--bottom" aria-hidden="true"></div>
        </div>
    </div>
    <div id="game-main">
        <div id="game-actions">
            <button type="button" id="game-back-btn" class="game-icon-btn" aria-label="Go back">
                <svg class="game-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="game-tooltip" aria-hidden="true">Back</span>
            </button>
            <div id="game-icon-btns">
                <button type="button" id="game-theme-btn" class="game-icon-btn theme-toggle-btn" aria-label="Toggle theme">
                    <span class="theme-icon-wrap" aria-hidden="true">
                        <svg class="game-icon theme-icon theme-icon--sun" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/>
                            <path d="M12 2V4M12 20V22M4 12H2M22 12H20M6.34 6.34L4.93 4.93M19.07 19.07L17.66 17.66M17.66 6.34L19.07 4.93M4.93 19.07L6.34 17.66" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                        <svg class="game-icon theme-icon theme-icon--moon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </span>
                    <span class="game-tooltip" aria-hidden="true">Theme</span>
                </button>
                <button type="button" id="game-stats-btn" class="game-icon-btn" aria-label="Statistics">
                    <svg class="game-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M18 20V10M12 20V4M6 20V14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <span class="game-tooltip" aria-hidden="true">Statistics</span>
                </button>
                <button type="button" id="game-help-btn" class="game-icon-btn" aria-label="How to play">
                    <svg class="game-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/>
                        <path d="M9.5 9.5C9.5 8.12 10.62 7 12 7C13.38 7 14.5 8.12 14.5 9.5C14.5 10.64 13.77 11.62 12.75 11.96C12.32 12.1 12 12.5 12 12.95V13.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                        <circle cx="12" cy="16.5" r="0.75" fill="currentColor"/>
                    </svg>
                    <span class="game-tooltip" aria-hidden="true">How to Play</span>
                </button>
            </div>
        </div>
        <p id="game-text">Flip over cards and match related words into pairs</p>
        <div id="game-board"></div>
        <div id="game-info">
            <div id="game-stats-row">
                <div id="moves-counter">
                    <span id="moves-count">0</span>
                    <span class="game-stat-label">moves</span>
                </div>
                <div id="pairs-counter">
                    <div id="pairs-fraction">
                        <span id="pairs-found" class="game-stat-value">0</span>
                        <span class="game-stat-label">of</span>
                        <span id="total-pairs" class="game-stat-value">6</span>
                    </div>
                    <span class="game-stat-label">pairs found</span>
                </div>
            </div>
            <div id="mistake-counter">
                <span class="game-stat-label">Mistakes remaining:</span>
                <div id="mistake-dots">
                    <span class="mistake-dot"></span>
                    <span class="mistake-dot"></span>
                    <span class="mistake-dot"></span>
                    <span class="mistake-dot"></span>
                    <span class="mistake-dot"></span>
                    <span class="mistake-dot"></span>
                </div>
            </div>
        </div>
    </div>

    

<script
src="https://code.jquery.com/jquery-3.6.0.min.js"
integrity="sha256-/xUj+3OJU5yExlq6GSYGSHk7tPXikynS7ogEvDej/m4="
crossorigin="anonymous"></script>
<script src="../scripts/script.js">
</script>
</body>
</html>