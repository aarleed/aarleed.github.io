---
// ayo why you lookin at the code 
import "../styles/style.css";
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WordPair</title>
    <!-- <link rel="stylesheet" href="../styles/style.css"> -->
    <script src="https://cdn.plot.ly/plotly-2.30.0.min.js"
            integrity="sha384-H7GB7Kme/VbPI/0S4LNq7OixFNVRgRGE8kyqTntBuiXle1KBm8KWLQh/Ah6bXCYW"
            crossorigin="anonymous"
            charset="utf-8"></script>
    <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"
  />
    <link rel="preconnect" href="https://fonts.cdnfonts.com" crossorigin />
    <link href="https://fonts.cdnfonts.com/css/tex-gyre-heros" rel="stylesheet" />
</head>
<body>
    <h1> WordPair </h1>

    <div id="instructions-modal" class="modal-class instructions-modal">
        <div id="instructions-content" role="dialog" aria-modal="true" aria-labelledby="instructions-heading">
            <button type="button" id="instructions-close" class="instructions-close-btn" aria-label="Close how to play">
                <svg class="instructions-close-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M6 6L18 18M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
            </button>
            <div class="instructions-sheet-body">
                <header class="instructions-block instructions-heading-block">
                    <h2 id="instructions-heading" class="instructions-h2">How to Play</h2>
                    <p class="instructions-lead">Flip over cards and match related words into pairs.</p>
                </header>
                <section class="instructions-block instructions-rules" aria-labelledby="instructions-rules-heading">
                    <h3 id="instructions-rules-heading" class="instructions-h4">Rules</h3>
                    <ol class="instructions-ol">
                        <li class="instructions-li">Each word must be <strong>semantically related</strong>—they may be synonyms, antonyms, or share a common theme. Each word has <strong>exactly one</strong> pairing word.</li>
                        <li class="instructions-li">Find all 6 pairs without making 6 mistakes.</li>
                    </ol>
                </section>
                <section class="instructions-block instructions-mistake" aria-labelledby="instructions-mistake-heading">
                    <h3 id="instructions-mistake-heading" class="instructions-h4">Whats a mistake?</h3>
                    <p class="instructions-body">A mistake happens when you flip over a card you've already flipped before, but don't find its match.</p>
                </section>
                <section class="instructions-block instructions-examples" aria-labelledby="instructions-examples-heading">
                    <h3 id="instructions-examples-heading" class="instructions-h4">Examples</h3>
                    <div class="instructions-example-row">
                        <div class="instructions-example-card instructions-example-card--green">dull</div>
                        <span class="instructions-example-muted">and</span>
                        <div class="instructions-example-card instructions-example-card--green">sharp</div>
                        <span class="instructions-example-muted">are a pair.</span>
                    </div>
                    <div class="instructions-example-row">
                        <div class="instructions-example-card instructions-example-card--orange">damp</div>
                        <span class="instructions-example-muted">and</span>
                        <div class="instructions-example-card instructions-example-card--orange">wet</div>
                        <span class="instructions-example-muted">are a pair.</span>
                    </div>
                    <div class="instructions-example-row">
                        <div class="instructions-example-card instructions-example-card--blue">Vegas</div>
                        <span class="instructions-example-muted">and</span>
                        <div class="instructions-example-card instructions-example-card--blue">gamble</div>
                        <span class="instructions-example-muted">are a pair.</span>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <div id="modal" class="modal-class">
        <div id="modal-content">
            <span id="close" class="close">&times;</span>
            <p id="modal-text">Welcome! start clicking on the cards and find pairs based on word meanings!</p>
            <div id="game-statistics"></div>
            <div id="graph"></div>
        </div>
    </div>
    
    <div id="statistics">
        
    </div>
    <div id="game-board"> 

    </div>

    <div id ="game-dialog">
        <div id="mistakes">mistakes: 0</div>
        <div id="game-text">Welcome! start clicking on the cards and find pairs based on word meanings. You have up to 6 mistakes!</div>
    </div>

    <div id="test"></div>

    <!-- Test controls for streak animation development -->
    <div id="streak-test-controls" style="position:fixed;bottom:16px;left:16px;z-index:999;display:flex;gap:8px;">
        <button type="button" id="start-add-streak-btn" style="padding:8px 12px;border-radius:8px;border:1px solid #ccc;background:#fff;cursor:pointer;">Add Streak</button>
    </div>

    

<script
src="https://code.jquery.com/jquery-3.6.0.min.js"
integrity="sha256-/xUj+3OJU5yExlq6GSYGSHk7tPXikynS7ogEvDej/m4="
crossorigin="anonymous"></script>
<script src="../scripts/scriptAB.js">
</script>
</body>
</html>